# Copy this file to keystore.properties and fill in your values.
# keystore.properties is gitignored — never commit it.
#
# Generate a keystore with:
#   keytool -genkeypair -v -storetype PKCS12 \
#           -keystore release.jks -alias release \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# Store the .jks file somewhere safe (NOT inside this repo).

storeFile=../release.jks
storePassword=your_store_password
keyAlias=release
keyPassword=your_key_password
